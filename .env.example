# Copy this file to `.env` and fill in the keys you actually need.
# Only the providers you select in config.yaml are required.

# --- Brain / STT (Groq, OpenAI-SDK compatible) ----------------------------
# Used when providers.llm = groq or providers.stt = groq
GROQ_API_KEY=

# --- TTS (ElevenLabs streaming) -------------------------------------------
# Used when providers.tts = elevenlabs
ELEVENLABS_API_KEY=

# --- Optional: Gemini ------------------------------------------------------
# Used when providers.llm = gemini, and for the Phase 4 computer-use
# vision fallback. Free-tier inputs may be used for training — never pipe
# anything sensitive through it.
GEMINI_API_KEY=

# --- Optional: Anthropic (high-reasoning escalation) ----------------------
# API billing is separate from any Claude Pro subscription. Leave blank
# unless you've explicitly funded the API account.
ANTHROPIC_API_KEY=
